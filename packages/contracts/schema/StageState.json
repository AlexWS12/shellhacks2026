{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed"
      ],
      "type": "string"
    },
    "used_fallback": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "counts",
    "used_fallback"
  ],
  "title": "StageState",
  "type": "object"
}
