{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "page",
        "locator",
        "stage"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "rule_id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "error",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "subject": {
      "type": "string"
    }
  },
  "required": [
    "rule_id",
    "severity",
    "subject",
    "message",
    "provenance"
  ],
  "title": "Check",
  "type": "object"
}
