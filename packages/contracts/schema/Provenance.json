{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "file": {
      "type": "string"
    },
    "locator": {
      "type": "string"
    },
    "page": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "type": "string"
    }
  },
  "required": [
    "file",
    "page",
    "locator",
    "stage"
  ],
  "title": "Provenance",
  "type": "object"
}
